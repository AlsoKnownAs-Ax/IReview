{
  "extends": "./tsconfig.paths.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/*/main/**/*",
    "src/*/host/**/*",
    "src/*/core/**/*",
    "src/*/contract/**/*",
    "src/git/**/*",
    "src/shared/**/*",
    "scripts/**/*",
    "playwright.config.ts",
    "tests/**/*"
  ]
}
